# MLIR to QIR Translator Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to git - it contains secrets!

# ===========================================
# LLM Configuration
# ===========================================
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b-instruct  # Options: llama3.1:8b-instruct, llama3.1:70b-instruct-q4_K_M, codellama:13b
LLM_TEMPERATURE=0.1  # Low temperature for deterministic translation
LLM_BASE_URL=http://localhost:11434
LLM_MAX_TOKENS=4000

# ===========================================
# RAG Configuration
# ===========================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5
CHROMADB_PATH=data/chromadb

# ===========================================
# Verification Settings
# ===========================================
GATE_COUNT_TOLERANCE=0.0  # 0.0 = exact match required
DEPTH_TOLERANCE=1  # Allow +/- 1 difference
SIMULATION_SIMILARITY_THRESHOLD=0.95  # 95% similarity required
SIMULATION_SHOTS=1000

# ===========================================
# Agent Configuration
# ===========================================
MAX_ITERATIONS=3
AGENT_VERBOSE=true
ENABLE_MEMORY=true

# ===========================================
# Dialect Configuration
# ===========================================
DEFAULT_DIALECT=auto  # Options: auto, catalyst, quake

# ===========================================
# Backend Configuration
# ===========================================
# Path to qir-runner executable (leave empty to search in PATH)
QIR_RUNNER_PATH=

# Path to catalyst-cli (leave empty if using Python API)
CATALYST_CLI_PATH=

# Enable/disable simulators
ENABLE_QISKIT=true
ENABLE_CIRQ=false

# ===========================================
# HuggingFace Token (REQUIRED before running!)
# ===========================================
# Get your token from: https://huggingface.co/settings/tokens
# IMPORTANT: Add this before running to prevent token leakage!
HUGGINGFACE_TOKEN=your_token_here
HF_TOKEN=your_token_here

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
LOG_DIR=logs
ENABLE_FILE_LOGGING=true

# ===========================================
# Cache
# ===========================================
ENABLE_CACHE=true
CACHE_DIR=data/cache
