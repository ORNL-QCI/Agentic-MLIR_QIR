# ============================================================
# Project-specific runtime artifacts
# ============================================================

# Translation / session logs (auto-generated at runtime)
logs/

# Runtime per-circuit run logs (auto-generated by translate.py)
example_run_info/

# Experiment results — regenerate via experiments/run_*.sh
experiments/results/
experiments/analysis-output/

# Chroma / RAG cache (only used by optional HITL UI feature)
data/chromadb/
data/cache/
data/discovered_simulators.json
chroma_db/

# Knowledge base (auto-fetched if RAG is enabled)
