@startuml MLIR_QIR_Class_Diagram
!theme plain
skinparam linetype ortho
skinparam packageStyle rectangle

' ========== Dialect System ==========
package "Dialect System" {
    abstract class BaseDialect {
        +{abstract} name: str
        +{abstract} can_parse(mlir_code: str): bool
        +{abstract} parse_circuit(mlir_code: str): MLIRCircuit
        +{abstract} parse_gates(mlir_code: str): List[GateOperation]
        +{abstract} parse_qubits(mlir_code: str): QubitAllocation
        +{abstract} parse_measurements(mlir_code: str): List[MeasurementOperation]
        +{abstract} get_gate_mapping(): Dict[str, str]
        +get_qir_function_name(gate_name: str): Optional[str]
        +validate_circuit(circuit: MLIRCircuit): Tuple[bool, List[str]]
    }

    class CatalystDialect {
        +name: str = "catalyst"
        +GATE_MAPPING: Dict[str, str]
        +can_parse(mlir_code: str): bool
        +parse_circuit(mlir_code: str): MLIRCircuit
        +parse_gates(mlir_code: str): List[GateOperation]
        +parse_qubits(mlir_code: str): QubitAllocation
        +parse_measurements(mlir_code: str): List[MeasurementOperation]
        +get_gate_mapping(): Dict[str, str]
        -_ssa_parse(mlir_code: str, num_qubits: int): Tuple
        -_parse_num_qubits(mlir_code: str): int
        -_extract_operand_vars(operands_str: str): List[str]
        -_resolve_qubit(var_name: str, ssa_qubit: Dict): int
        -_parse_parameters(params_str: str, ssa_constants: Dict): List[float]
        --
        .. SSA Tracking Maps ..
        ssa_qubit: Dict[str, int]
        ssa_constants: Dict[str, float]
        ssa_meas_source: Dict[str, int]
    }

    class QuakeDialect {
        +name: str = "quake"
        +GATE_MAPPING: Dict[str, str]
        +can_parse(mlir_code: str): bool
        +parse_circuit(mlir_code: str): MLIRCircuit
        +parse_gates(mlir_code: str): List[GateOperation]
        +parse_qubits(mlir_code: str): QubitAllocation
        +parse_measurements(mlir_code: str): List[MeasurementOperation]
        +get_gate_mapping(): Dict[str, str]
        -_extract_qubit_variables(mlir_code: str): Dict[str, int]
        -_parse_parameter(param_str: str): float
    }

    class DialectDetector {
        -dialects: List[BaseDialect]
        +detect(mlir_code: str): BaseDialect
        +get_available_dialects(): List[str]
        +get_dialect_by_name(name: str): BaseDialect
        +register_dialect(dialect: BaseDialect): void
    }

    BaseDialect <|-- CatalystDialect
    BaseDialect <|-- QuakeDialect
    DialectDetector o-- BaseDialect
}

' ========== Data Models ==========
package "Data Models" {
    class MLIRCircuit <<dataclass>> {
        +dialect_name: str
        +num_qubits: int
        +gates: List[GateOperation]
        +measurements: List[MeasurementOperation]
        +qubit_allocation: QubitAllocation
        +has_conditionals: bool
        +metadata: Dict[str, Any]
        +conditionals: List[ConditionalBlock]
        +ordered_ops: List[Tuple]
        --
        +__post_init__()
    }

    class GateOperation <<dataclass>> {
        +name: str
        +qubits: List[int]
        +params: List[float]
        +line_number: Optional[int]
    }

    class QubitAllocation <<dataclass>> {
        +num_qubits: int
        +allocation_type: str
        +qubit_vars: Dict[str, int]
    }

    class MeasurementOperation <<dataclass>> {
        +qubit: int
        +result_var: str
        +line_number: Optional[int]
    }

    class ConditionalBlock <<dataclass>> {
        +condition_measurement_idx: int
        +then_gates: List[GateOperation]
        +else_gates: List[GateOperation]
    }

    MLIRCircuit *-- GateOperation
    MLIRCircuit *-- QubitAllocation
    MLIRCircuit *-- MeasurementOperation
    MLIRCircuit *-- ConditionalBlock
    ConditionalBlock *-- GateOperation : then_gates / else_gates
}

note right of MLIRCircuit::ordered_ops
    Interleaved operation list:
    ("gate", GateOperation) |
    ("measurement", MeasurementOperation) |
    ("conditional", ConditionalBlock)
    Preserves source MLIR ordering.
end note

' ========== Parser & Generator ==========
package "Core Translation" {
    class MLIRParser {
        -dialect: Optional[BaseDialect]
        +parse(mlir_code: str): MLIRCircuit
        +get_detected_dialect(mlir_code: str): str
    }

    class QIRGenerator {
        -templates: QIRTemplates
        -conditional_counter: int
        +generate(circuit: MLIRCircuit, module_id: str, function_name: str): str
        -_generate_header(module_id: str): str
        -_generate_entry_function(circuit: MLIRCircuit, function_name: str): str
        -_generate_gate_call(gate: GateOperation): str
        -_generate_measurement(qubit_index: int, result_index: int): str
        -_generate_conditional(cond: ConditionalBlock): List[str]
        -_generate_declarations(circuit: MLIRCircuit): str
        -_generate_attributes(circuit: MLIRCircuit): str
        -_collect_gate_functions(circuit: MLIRCircuit): Dict[str, tuple]
        -_get_qir_function_name(gate_name: str): str
    }

    class QIRTemplates {
        +{static} HEADER: str
        +{static} ENTRY_FUNCTION: str
        +{static} SINGLE_QUBIT_GATE: str
        +{static} TWO_QUBIT_GATE: str
        +{static} PARAM_GATE: str
        +{static} MEASUREMENT: str
        +{static} MEASUREMENT_WITH_READ: str
        +{static} CONDITIONAL: str
        +{static} OUTPUT_RECORDING: str
        +{static} DECLARATIONS: str
        +{static} GATE_DECLARATION: str
        +{static} CONDITIONAL_DECLARATIONS: str
        +{static} ATTRIBUTES: str
        +{static} METADATA: str
        +{static} get_qubit_pointer(index: int): str
        +{static} get_result_pointer(index: int): str
        +{static} get_gate_param_signature(gate_name: str, num_qubits: int, has_param: bool): str
    }

    MLIRParser --> DialectDetector
    MLIRParser --> MLIRCircuit
    QIRGenerator --> MLIRCircuit
    QIRGenerator --> ConditionalBlock : generates conditional branches
    QIRGenerator *-- QIRTemplates
}

' ========== RAG System ==========
package "RAG System" {
    class KnowledgeBase {
        -client: chromadb.PersistentClient
        -collection: chromadb.Collection
        -embedding_function: SentenceTransformerEmbeddingFunction
        +query(query: str, n_results: int): List[Document]
        +query_with_scores(query: str): List[Tuple]
        +add_documents(documents: List[Document]): void
        +initialize(knowledge_dir: str): void
        +get_statistics(): Dict[str, Any]
        +count(): int
    }

    class DocumentFetcher {
        +SOURCES: Dict[str, Dict]
        +fetch_all(): void
        +fetch_source(name: str, config: Dict): void
        -_fetch_github(config: Dict): void
        -_fetch_arxiv(config: Dict): void
    }

    class DocumentChunker {
        +chunk_text(text: str, chunk_size: int, chunk_overlap: int): List[str]
        +chunk_code(code: str, language: str): List[str]
    }

    class MarkdownChunker {
        +chunk_text(text: str): List[str]
    }

    KnowledgeBase ..> DocumentChunker
    KnowledgeBase ..> MarkdownChunker
}

' ========== Agent System ==========
package "Multi-Agent System" {
    class CrewManager {
        -llm: BaseLLM
        -knowledge_base: KnowledgeBase
        -max_iterations: int
        -translation_agent: TranslationAgent
        -verification_agent: VerificationAgent
        +translate(mlir_code: str, dialect: Optional[str]): TranslationResult
        -_run_iteration(mlir_code: str, iteration: int): Tuple[str, Dict]
    }

    class TranslationResult <<dataclass>> {
        +qir_code: str
        +verification: Dict
        +iterations: int
        +iteration_history: List
        +success: bool
        +error_message: str
    }

    class TranslationAgent {
        -llm: BaseLLM
        -tools: List[BaseTool]
        +role: str
        +goal: str
        +backstory: str
        +translate(mlir_code: str, context: Dict): str
    }

    class VerificationAgent {
        -llm: BaseLLM
        -tools: List[BaseTool]
        +role: str
        +goal: str
        +backstory: str
        +verify(mlir_code: str, qir_code: str): Dict[str, Any]
    }

    class RAGTool {
        -knowledge_base: KnowledgeBase
        +_run(query: str): str
    }

    class GateCounterTool {
        +_run(code: str, code_type: str): str
    }

    class SimulationTool {
        -simulator_registry: SimulatorRegistry
        +_run(code: str, code_type: str, shots: int): str
    }

    CrewManager o-- TranslationAgent
    CrewManager o-- VerificationAgent
    CrewManager --> KnowledgeBase
    CrewManager --> TranslationResult : creates
    TranslationAgent --> RAGTool
    VerificationAgent --> GateCounterTool
    VerificationAgent --> SimulationTool
}

' ========== Verification System ==========
package "Verification System" {
    abstract class BaseRunner {
        +{abstract} name: str
        +{abstract} is_available(): bool
        +{abstract} run(code: str, shots: int): Dict[str, int]
        +{abstract} get_circuit_info(code: str): Dict
    }

    class QIRRunner {
        +name: str = "qir-runner"
        +is_available(): bool
        +run(code: str, shots: int): Dict[str, int]
        -_parse_results(output: str): Dict[str, int]
    }

    class CatalystRunner {
        +name: str = "catalyst"
        +is_available(): bool
        +run(code: str, shots: int): Dict[str, int]
    }

    class QiskitRunner {
        +name: str = "qiskit"
        +is_available(): bool
        +run(code: str, shots: int): Dict[str, int]
    }

    class SimulatorRegistry {
        +{static} backends: Dict[str, Type[BaseRunner]]
        +{static} get_backend(name: str): BaseRunner
        +{static} register(backend_class: Type[BaseRunner]): void
        +{static} list_available(): List[str]
        +{static} list_all(): List[str]
        +{static} get_status(): Dict[str, Dict]
    }

    class GateCounter {
        +count_mlir_gates(mlir_code: str): Dict[str, int]
        +count_qir_gates(qir_code: str): Dict[str, int]
        +compare(mlir_counts: Dict, qir_counts: Dict): Dict
        +get_missing_gates(): List[str]
        +get_extra_gates(): List[str]
    }

    class MetricsCalculator {
        +{static} compute_distribution_similarity(dist1: Dict, dist2: Dict): float
        +{static} compute_kl_divergence(dist1: Dict, dist2: Dict): float
        +{static} estimate_circuit_depth(code: str): int
    }

    class VerificationMetrics <<dataclass>> {
        +gate_count_match: bool
        +gate_count_similarity: float
        +mlir_gate_count: int
        +qir_gate_count: int
        +depth_match: bool
        +simulation_similarity: float
        +simulation_passed: bool
        +overall_pass: bool
        +missing_gates: List[str]
        +extra_gates: List[str]
        +gate_discrepancies: List[Dict]
    }

    BaseRunner <|-- QIRRunner
    BaseRunner <|-- CatalystRunner
    BaseRunner <|-- QiskitRunner
    SimulatorRegistry o-- BaseRunner
    GateCounter --> VerificationMetrics : produces
}

' ========== UI Layer ==========
package "User Interface" {
    class StreamlitApp {
        +main(): void
        +initialize_session_state(): void
        +render_sidebar(): Dict
        +render_translation_section(config: Dict): void
        +render_verification_section(): void
        +load_examples(): Dict[str, str]
    }

    class LLMConfig {
        +MODELS: Dict[str, ModelInfo]
        +{static} get_ollama_model_name(model_key: str): str
        +{static} estimate_vram(model_key: str): str
    }

    class ModelInfo <<dataclass>> {
        +size: str
        +quantization: str
        +vram: str
        +quality: str
        +speed: str
        +recommended_for: str
        +ollama_name: str
    }

    StreamlitApp --> MLIRParser
    StreamlitApp --> QIRGenerator
    StreamlitApp --> LLMConfig
    LLMConfig *-- ModelInfo
}

' ========== Configuration ==========
package "Configuration" {
    class Settings <<BaseSettings>> {
        +LLM_MODEL: str
        +LLM_TEMPERATURE: float
        +LLM_BASE_URL: str
        +EMBEDDING_MODEL: str
        +CHROMADB_PATH: str
        +RAG_TOP_K: int
        +CHUNK_SIZE: int
        +SIMULATION_SIMILARITY_THRESHOLD: float
        +GATE_COUNT_TOLERANCE: float
        +DEPTH_TOLERANCE: int
        +MAX_ITERATIONS: int
        +ENABLE_QISKIT: bool
        +HUGGINGFACE_TOKEN: str
    }
}

' ========== Exceptions ==========
package "Exceptions" {
    class UnsupportedDialectError
    class ParsingError
}

' ========== Main Relationships ==========
StreamlitApp ..> CrewManager : uses
MLIRParser ..> DialectDetector : uses
CrewManager ..> MLIRParser : uses
CrewManager ..> QIRGenerator : uses
SimulationTool ..> SimulatorRegistry : uses
RAGTool ..> KnowledgeBase : uses

@enduml
