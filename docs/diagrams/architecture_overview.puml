@startuml MLIR_QIR_Architecture_Overview
!theme plain
skinparam componentStyle rectangle

' ========== User Interface Layer ==========
package "User Interface Layer" {
    component [Streamlit Web UI] as UI
    component [Model Selector] as ModelSelector
    component [Example Loader] as ExampleLoader
    component [Visualization\n(50/50 Split)] as Viz
}

' ========== API/Controller Layer ==========
package "Application Layer" {
    component [Session Manager] as Session
    component [Configuration Manager\n(Pydantic Settings)] as Config
}

' ========== Agent Orchestration Layer ==========
package "Multi-Agent System" <<LLM Powered>> {
    component [Crew Manager\n(max 3 iterations)] as CrewManager {
        portin translate_input
        portout translation_output
    }

    component [Translation Agent] as TransAgent {
        note right: Role: MLIR to QIR Specialist\nGoal: Accurate translation\nTools: RAG, Pattern Matcher
    }

    component [Verification Agent] as VerifyAgent {
        note right: Role: Verification Specialist\nGoal: Validate correctness\nTools: Gate Counter, Simulator
    }

    component [RAG Tool] as RAGTool
    component [Gate Counter Tool] as GateCounterTool
    component [Simulation Tool] as SimTool
}

' ========== Core Translation Layer ==========
package "Core Translation Engine" {
    component [MLIR Parser] as Parser {
        portin mlir_input
        portout circuit_output
    }

    component [Dialect Detector] as Detector

    component [Catalyst Dialect\n(SSA-Aware Parser)] as Catalyst {
        note right #FFEECC
            **SSA Tracking Maps:**
            ssa_qubit: %var -> qubit idx
            ssa_constants: %var -> float
            ssa_meas_source: %var -> meas idx

            **Handles:**
            - arith.constant (params)
            - quantum.extract (qubit mapping)
            - quantum.custom (1/2-qubit gates)
            - quantum.measure (measurements)
            - scf.if (conditional blocks)
            - tensor/stablehlo (meas tracing)
        end note
    }
    component [Quake Dialect] as Quake
    component [Future Dialects...] as FutureDialects

    component [QIR Generator\n(Ordered Ops)] as Generator {
        portin circuit_input
        portout qir_output
        note right #CCFFCC
            **Generates in source order:**
            - Gate calls (1q, 2q, parametric)
            - Measurements (mz_body)
            - Conditional branches (br i1)
            - Output recording
            - Function declarations
        end note
    }

    component [QIR Templates] as Templates
}

' ========== Data Model ==========
package "Data Model" {
    component [MLIRCircuit] as Circuit {
        note right #E8E8FF
            gates: List[GateOperation]
            measurements: List[MeasurementOperation]
            conditionals: List[ConditionalBlock]
            **ordered_ops: List[Tuple]**
            (interleaved gate/meas/cond)
        end note
    }

    component [GateOperation\n(name, qubits, params)] as GateOp
    component [MeasurementOperation\n(qubit, result_var)] as MeasOp
    component [ConditionalBlock\n(meas_idx, then/else gates)] as CondBlock
}

' ========== Knowledge & RAG Layer ==========
package "Knowledge Base & RAG" {
    database "ChromaDB\n(Vector Store)" as ChromaDB {
        folder "QIR Specifications" as QIRSpecs
        folder "MLIR Documentation" as MLIRDocs
        folder "Gate Mappings" as GateMappings
        folder "Translation Patterns" as Patterns
        folder "Research Papers" as Papers
    }

    component [Knowledge Base Manager\n(SentenceTransformer Embeddings)] as KBManager
    component [Document Fetcher] as Fetcher {
        note right: Auto-fetches from:\n- QIR Alliance GitHub\n- PennyLane Catalyst\n- CUDA Quantum\n- arXiv papers
    }
    component [Document Chunker\n(Markdown-aware)] as Chunker
}

' ========== Verification & Execution Layer ==========
package "Verification & Execution" {
    component [Simulator Registry\n(Plugin-based)] as SimRegistry

    component [QIR Runner] as QIRRunner {
        note right: Executes QIR circuits\nusing qir-runner tool
    }

    component [Catalyst Runner] as CatalystRunner {
        note right: Executes Catalyst MLIR\nusing PennyLane runtime
    }

    component [Qiskit Runner] as QiskitRunner {
        note right: Executes via\nQiskit simulator
    }

    component [Gate Counter\n(MLIR & QIR)] as GateCounter
    component [Metrics Calculator\n(TVD, KL Divergence)] as Metrics
}

' ========== External Systems ==========
package "External Systems" {
    component [Ollama LLM Server] as Ollama {
        note right: Models:\n- Llama 3.1 8B (4.7GB)\n- CodeLlama 13B (7.4GB)\n- Llama 3.1 70B-Q4 (40GB)
    }

    cloud "External Sources" as ExtSources {
        component [GitHub\nQIR Alliance] as GitHub
        component [arXiv] as ArXiv
        component [HuggingFace\n(Embeddings)] as HF
    }
}

' ========== UI Layer Connections ==========
UI --> Session
UI --> Config
UI --> ModelSelector
UI --> ExampleLoader
UI --> Viz

Session --> Parser : Direct translation
Session --> CrewManager : Multi-agent translation

' ========== Agent System Connections ==========
CrewManager *-- TransAgent
CrewManager *-- VerifyAgent
CrewManager --> Parser
CrewManager --> Generator

TransAgent --> RAGTool
TransAgent --> Ollama : LLM queries

VerifyAgent --> GateCounterTool
VerifyAgent --> SimTool
VerifyAgent --> Ollama : LLM queries

RAGTool --> KBManager
GateCounterTool --> GateCounter
SimTool --> SimRegistry

' ========== Core Translation Connections ==========
Parser --> Detector
Detector --> Catalyst
Detector --> Quake
Detector --> FutureDialects

Parser ..> Circuit : creates
Catalyst ..> Circuit : populates (ordered_ops)

Generator --> Templates
Generator <.. Circuit : uses ordered_ops
Generator ..> CondBlock : generates br i1 branches

' ========== Data Model Connections ==========
Circuit *-- GateOp
Circuit *-- MeasOp
Circuit *-- CondBlock

' ========== Knowledge Base Connections ==========
KBManager --> ChromaDB
KBManager --> Chunker

Fetcher --> ExtSources
Fetcher --> KBManager : populates

' ========== Verification Connections ==========
SimRegistry --> QIRRunner
SimRegistry --> CatalystRunner
SimRegistry --> QiskitRunner

GateCounter --> Metrics
SimRegistry --> Metrics

' ========== Configuration Flow ==========
Config --> CrewManager : LLM settings
Config --> KBManager : RAG settings
Config --> SimRegistry : Verification settings

' ========== Data Flow Notes ==========
note top of Parser
    **Translation Data Flow:**
    MLIR Code -> Dialect Detection ->
    SSA-Aware Parsing -> MLIRCircuit
    (with ordered_ops) -> QIR Generator
    -> QIR Code (.ll)
end note

note top of CrewManager
    **Agent Flow:**
    1. TransAgent translates with RAG context
    2. VerifyAgent validates (gate count + simulation)
    3. Iterate if verification fails (max 3x)
    4. Return TranslationResult
end note

note top of ChromaDB
    **Knowledge Sources:**
    - QIR Alliance specification docs
    - Catalyst MLIR dialect docs
    - CUDA Quantum (Quake) docs
    - Gate mapping reference tables
    - Translation pattern examples
    - Research papers (arXiv)
end note

note bottom of SimRegistry
    **4-Level Verification:**
    Level 1: Gate count comparison (exact match)
    Level 2: QIR execution (qir-runner)
    Level 3: MLIR execution (dialect-specific)
    Level 4: Statistical comparison (TVD, KL, 95%)
end note

note bottom of Catalyst
    **17 Gates Supported:**
    1q: H, X, Y, Z, S, T, Sdg, Tdg, RX, RY, RZ
    2q: CNOT, CZ, SWAP, CY
    3q: Toffoli, CSWAP
end note

' ========== Layers ==========
together {
    UI
    Session
    Config
}

together {
    CrewManager
    TransAgent
    VerifyAgent
}

together {
    Parser
    Generator
}

together {
    KBManager
    ChromaDB
}

together {
    SimRegistry
    QIRRunner
    CatalystRunner
}

@enduml
